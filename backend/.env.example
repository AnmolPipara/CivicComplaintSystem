# Database
DATABASE_URL=postgresql://<username>:<password>@localhost:5434/civic_complaints

# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# External Services (stubs for development)
EMAIL_SERVICE_API_KEY=
SMS_SERVICE_API_KEY=
PUSH_SERVICE_API_KEY=

# Priority Engine Weights (must sum to 1.0)
PRIORITY_WEIGHT_SEVERITY=0.30
PRIORITY_WEIGHT_LOCATION=0.25
PRIORITY_WEIGHT_AGEING=0.25
PRIORITY_WEIGHT_VOTES=0.20

# Priority Thresholds
PRIORITY_HIGH_THRESHOLD=0.7
PRIORITY_MEDIUM_THRESHOLD=0.4

# Ageing
MAX_AGE_DAYS=30
AGEING_CURVE=linear

# Location Sensitivity
SENSITIVE_ZONE_RADIUS_KM=2.0
HIGH_FOOTFALL_RADIUS_KM=1.0

# Vote Saturation
VOTE_SATURATION=50

# App
ENVIRONMENT=development
DEBUG=true
SQL_ECHO=false